# =============================================================================
# Last-Mile Delivery Tracker — Backend Environment Variables
# Copy this file to .env and fill in real values.
# =============================================================================

# --- Server ---
PORT=4000
# In production the server refuses to start without a strong JWT_SECRET.
# NODE_ENV=production
# Comma-separated list of frontend origins allowed to call the API.
# Leave empty for local dev (any origin). Example for the live demo:
# CORS_ORIGIN=https://consignly.vercel.app
CORS_ORIGIN=

# --- Database ---
# Local/quick-start (SQLite, zero config, default): leave DB_DIALECT unset
# or "sqlite". DATABASE_URL is ignored in this mode; the file is created at
# backend/dev.db automatically (override the path with SQLITE_STORAGE).
DB_DIALECT=sqlite
SQLITE_STORAGE=./dev.db

# Production (Postgres): set DB_DIALECT=postgres and provide a connection
# string. No other code changes needed — same models, same controllers.
# DB_DIALECT=postgres
# DATABASE_URL="postgresql://user:password@host:5432/lastmile"
# PG_SSL=true   # needed for most managed Postgres providers (Render, Railway, Supabase)

# --- Auth ---
# Generate one with: openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Failed login/register attempts allowed per IP per 15 minutes.
AUTH_RATE_LIMIT=20

# --- Rate engine ---
# Divisor used for volumetric weight = (L x B x H) / VOLUMETRIC_DIVISOR
VOLUMETRIC_DIVISOR=5000

# --- Email (SMTP) — any free-tier provider works ---
# Leave SMTP_HOST empty to run with email notifications logged to console
# only (useful for local dev / grading without setting up an inbox).
#
# Example using Gmail (requires an "App Password", not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# Example using Brevo (Sendinblue) free tier:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your-brevo-login
#   SMTP_PASS=your-brevo-smtp-key
#
# Example using Ethereal (fake inbox for testing, https://ethereal.email):
#   SMTP_HOST=smtp.ethereal.email
#   SMTP_PORT=587
#   SMTP_USER=generated-user@ethereal.email
#   SMTP_PASS=generated-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Last-Mile Delivery <no-reply@lastmile.local>"

# --- SMS ---
# SMS is implemented as a logging stub in src/utils/notify.js (sendSms).
# Wire in a real provider (Twilio free trial / Fast2SMS free tier) by
# replacing the body of sendSms() — no other code needs to change.
